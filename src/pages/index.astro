---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const all = await getCollection("posts", ({ data }) => !data.draft);
const recent = all
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);
---

<BaseLayout title="변호사가 로컬 LLM을 만지는 기록">
  <p style="font-size: 22px; font-weight: 600; margin: 0 0 10px;">
    변호사가 로컬 LLM을 만지는 기록
  </p>
  <p style="color: var(--text-secondary); margin: 0 0 2.5em;">
    의뢰인 자료를 밖으로 내보내지 않으면서 AI를 쓰는 방법을 찾고 있습니다. 잘 된 것만 쓰지는 않습니다.
  </p>

  <div>
    {recent.map((post) => (
      <div class="post-item">
        <p class="meta">
          {post.data.episode !== undefined && (
            <span class="ep-badge">{post.data.episode}화</span>
          )}
          <span> {post.data.pubDate.toISOString().slice(0, 10)}</span>
        </p>
        <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </div>
    ))}
  </div>

  <p style="margin-top: 2em;">
    <a href="/series/">연재 전체 보기 →</a>
  </p>
</BaseLayout>
